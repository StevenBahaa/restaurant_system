<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_config_view_form_inherit_restaurant_pos_kitchen" model="ir.ui.view">
        <field name="name">pos.config.form.inherit.restaurant.pos.kitchen</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='title']" position="after">
                <group name="restaurant_kitchen_group" string="Kitchen Integration" invisible="context.get('pos_config_create_mode', False)">
                    <field name="restaurant_order_channel" readonly="has_active_session"/>
                    <field name="kitchen_send_policy" readonly="has_active_session"/>
                    <field name="kitchen_dispatch_policy" readonly="has_active_session"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
