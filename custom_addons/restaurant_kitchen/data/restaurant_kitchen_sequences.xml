<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_restaurant_kitchen_order" model="ir.sequence">
            <field name="name">Kitchen Preparation Order</field>
            <field name="code">restaurant.kitchen.order</field>
            <field name="prefix">KPO/%(y)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_restaurant_kitchen_ticket" model="ir.sequence">
            <field name="name">Kitchen Ticket</field>
            <field name="code">restaurant.kitchen.ticket</field>
            <field name="prefix">KT/%(y)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
